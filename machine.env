# Machine identifiers. This is the only file to edit on a new machine.
#
# The launcher exports these before starting polybar, so the ini files and the scripts share them.
# Each ini reference keeps the value below as fallback, so the bar starts without the launcher too.
#
# How to find each value:
#   ip -o link show                     network interfaces
#   nmcli connection show               NetworkManager connection names
#   ls /sys/class/power_supply          battery
#   ls /sys/class/backlight             backlight card
#   cat /sys/class/thermal/*/type       thermal zone types

# Network links, one numbered slot per interface, named here rather than auto-detected.
# To add one, declare the next slot and copy its module block in config.d/networking.ini.
POLYBAR_WLAN0=wlp131s0f0
POLYBAR_ETH0=enp132s0

# VPN, named by its NetworkManager profile. The device it runs on is asked to NetworkManager.
POLYBAR_VPN0=Corsek

POLYBAR_BATTERY=BAT1
POLYBAR_BACKLIGHT=intel_backlight

# Thermal zone reporting the cpu package temperature.
POLYBAR_THERMAL=x86_pkg_temp

# Second filesystem to watch. The module hides itself when not mounted.
POLYBAR_DATA_MOUNT=/data
